# Lead webhook URL: Cloudflare Pages secret read by functions/api/leads.ts. Form submissions are POSTed here (e.g. a GHL inbound webhook).
# Not required to run the local demo.
LEAD_WEBHOOK_URL=

# GoHighLevel API credentials (future). Not required to run the local demo.
GHL_API_KEY=
GHL_LOCATION_ID=

# Analytics IDs (future). Not required to run the local demo.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
